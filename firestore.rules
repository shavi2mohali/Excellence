rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveApprovedUser() {
      return userProfileExists()
        && currentUser().active == true
        && currentUser().approvalStatus == 'approved';
    }

    function isScertAdmin() {
      return isActiveApprovedUser()
        && currentUser().systemRole == 'scert_admin';
    }

    function role() {
      
       return isActiveApprovedUser()
        ? currentUser().systemRole
        : null;
    }

    function isOwnPendingUserProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.systemRole == 'pending_user'
        && request.resource.data.role == 'pending_user'
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.active == false
        && request.resource.data.isActive == false
        && request.resource.data.approved == false
        && ((request.resource.data.organisationRole == 'architecture_department'
          && request.resource.data.architectureZone in ['north','south','east','west']
          && request.resource.data.get('districtId','') == '')
          || (request.resource.data.organisationRole in ['diet','pwd','rdp']
            && request.resource.data.districtId is string
            && request.resource.data.districtId.size() > 0));
    }

    function isOwnPendingRegistrationRequest(requestId) {
      return isSignedIn()
        && request.auth.uid == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && ((request.resource.data.organisationRole == 'architecture_department'
          && request.resource.data.requestedSystemRole == 'architecture_user'
          && request.resource.data.architectureZone in ['north','south','east','west']
          && request.resource.data.get('districtId','') == '')
          || (request.resource.data.organisationRole in ['diet','pwd','rdp']
            && request.resource.data.districtId is string
            && request.resource.data.districtId.size() > 0));
    }

    function isViewer() {
      return role() == 'scert_viewer';
    }

    function canViewAllDiets() {
      return role() in ['scert_admin', 'scert_viewer', 'finance_officer', 'monitoring_officer'];
    }

    function assignedToDiet(dietId) {
      return role() == 'diet_nodal_officer'
        && currentUser().assignmentStatus == 'assigned'
        && (dietId == currentUser().get('primaryDietId', null)
          || dietId in currentUser().get('assignedDietIds', []));
    }

    function assignedToAgency(agencyId) {
      return role() == 'agency_user'
        && currentUser().assignmentStatus == 'assigned'
        && (agencyId == currentUser().get('primaryAgencyId', null)
          || agencyId in currentUser().get('assignedAgencyIds', []));
    }

    function canReadExecutionRecord(data) {
      return canViewAllDiets()
        || assignedToDiet(data.dietId)
        || assignedToAgency(data.executingAgencyId);
    }
    function isArchitectureUser(){return role()=='architecture_user';}
    function assignedArchitectureDiet(dietId){return isArchitectureUser()&&currentUser().assignmentStatus=='assigned'&&dietId in currentUser().get('assignedDietIds',[]);}
    function architectureScopeStatus(status){return status in ['sent_to_architecture','architecture_review','architecture_revision_requested','architectural_drawings_issued','diet_drawing_review','drawing_revision_requested','diet_drawing_accepted','submitted_to_scert_for_drawing_approval','scert_drawing_review','scert_drawing_revision_required','architectural_drawings_approved'];}

    function canReadActivityFinancial(data) {
      return canViewAllDiets()
        || assignedToDiet(data.dietId)
        || (role() == 'agency_user'
          && currentUser().assignmentStatus == 'assigned'
          && (data.get('executingAgencyIds', []).hasAny(currentUser().get('assignedAgencyIds', []))
            || currentUser().get('primaryAgencyId', '') in data.get('executingAgencyIds', [])));
    }

    function packageIdentityUnchanged() {
      return request.resource.data.dietId == resource.data.dietId
        && request.resource.data.dietAgencyAssignmentId == resource.data.dietAgencyAssignmentId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.packageCode == resource.data.packageCode;
    }

    function permittedDraftPackageUpdate() {
      return resource.data.status in ['draft', 'revision_required']
        && request.resource.data.status in ['draft', 'revision_required', 'submitted']
        && request.resource.data.updatedBy == request.auth.uid
        && packageIdentityUnchanged()
        && validPackageLifecycle(request.resource.data)
        && request.resource.data.administrativeApprovalAmount == resource.data.administrativeApprovalAmount
        && request.resource.data.technicalSanctionAmount == resource.data.technicalSanctionAmount;
    }

    function hasValidActiveAssignment(data) {
      return exists(/databases/$(database)/documents/dietAgencyAssignments/$(data.dietAgencyAssignmentId))
        && get(/databases/$(database)/documents/dietAgencyAssignments/$(data.dietAgencyAssignmentId)).data.status == 'active'
        && get(/databases/$(database)/documents/dietAgencyAssignments/$(data.dietAgencyAssignmentId)).data.dietId == data.dietId
        && get(/databases/$(database)/documents/dietAgencyAssignments/$(data.dietAgencyAssignmentId)).data.executingAgencyId == data.executingAgencyId;
    }

    function hasValidScope(data) {
      return data.scopeOfWorkId is string
        && data.scopeOfWorkId.size() > 0
        && exists(/databases/$(database)/documents/scopeOfWorks/$(data.scopeOfWorkId))
        && get(/databases/$(database)/documents/scopeOfWorks/$(data.scopeOfWorkId)).data.dietId == data.dietId
        && get(/databases/$(database)/documents/scopeOfWorks/$(data.scopeOfWorkId)).data.executingAgencyId == data.executingAgencyId;
    }

    function historicalFinancialPhase(data) {
      return data.phaseSequence is int && data.phaseSequence > 0 && data.phaseSequence <= 2;
    }

    function validPackageLifecycle(data) {
      return historicalFinancialPhase(data) || (hasValidScope(data) && packageActivitiesWithinScope(data));
    }

    function packageActivitiesWithinScope(data) {
      return data.activityIds.hasOnly(
        get(/databases/$(database)/documents/scopeOfWorks/$(data.scopeOfWorkId)).data.activityIds
      );
    }

    function scopeIdentityUnchanged() {
      return request.resource.data.dietId == resource.data.dietId
        && request.resource.data.dietAgencyAssignmentId == resource.data.dietAgencyAssignmentId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId
        && request.resource.data.preparedBy == resource.data.preparedBy;
    }

    function dietScopeUpdateAllowed() {
      return assignedToDiet(resource.data.dietId)
        && resource.data.status in ['draft','architecture_revision_requested','diet_drawing_review','diet_drawing_accepted','drawing_revision_requested','revision_requested','revision_required']
        && request.resource.data.status in ['draft','architecture_revision_requested','sent_to_architecture','drawing_revision_requested','diet_drawing_accepted','submitted_to_scert_for_drawing_approval','released_to_executing_agency']
        && request.resource.data.updatedBy == request.auth.uid
        && scopeIdentityUnchanged()
        && request.resource.data.get('approvedBy', '') == resource.data.get('approvedBy', '')
        && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null);
    }
    function architectureScopeUpdateAllowed(){return assignedArchitectureDiet(resource.data.dietId)&&architectureScopeStatus(resource.data.status)&&request.resource.data.status in ['architecture_review','architecture_revision_requested','diet_drawing_review']&&scopeIdentityUnchanged()&&request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','currentDrawingRevision','dietAcceptedDrawingRevision','scertApprovedDrawingRevision','reviewHistory','updatedBy','updatedAt']);}

    function agencyScopeReviewAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status in ['sent_to_agency', 'agency_review']
        && request.resource.data.status in ['agency_review', 'revision_requested', 'agency_accepted']
        && scopeIdentityUnchanged()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'agencyReviewStatus', 'agencyReviewedBy', 'agencyReviewedAt', 'agencyComments',
          'agencyAcceptedBy', 'agencyAcceptedAt', 'reviewHistory', 'updatedBy', 'updatedAt'
        ]);
    }

    function agencyPackageWorkflowAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && packageIdentityUnchanged()
        && hasValidActiveAssignment(request.resource.data)
        && validPackageLifecycle(request.resource.data)
        && resource.data.status in ['draft', 'agency_revision', 'diet_revision_requested', 'diet_concurred', 'ready_for_scert', 'scert_revision_required', 'revision_required']
        && request.resource.data.status in ['draft', 'agency_revision', 'sent_to_diet', 'ready_for_scert', 'submitted_to_scert'];
    }

    function dietPackageReviewAllowed() {
      return assignedToDiet(resource.data.dietId)
        && packageIdentityUnchanged()
        && resource.data.status in ['sent_to_diet', 'diet_review']
        && request.resource.data.status in ['diet_review', 'diet_revision_requested', 'diet_concurred']
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'dietReviewStatus', 'dietReviewedBy', 'dietReviewedAt', 'dietReviewComments',
          'handshake', 'reviewHistory', 'updatedBy', 'updatedAt'
        ]);
    }

    function isAssignedAgencyUser() {
      return role() == 'agency_user'
        && currentUser().assignmentStatus == 'assigned'
        && (currentUser().get('assignedAgencyIds', []).size() > 0
          || currentUser().get('primaryAgencyId', null) != null);
    }

    function agencyContractorUpdateAllowed() {
      return isAssignedAgencyUser()
        && (resource.data.sourceAgencyId in currentUser().get('assignedAgencyIds', [])
          || resource.data.sourceAgencyId == currentUser().get('primaryAgencyId', null))
        && request.resource.data.contractorCode == resource.data.contractorCode
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.sourceAgencyId == resource.data.sourceAgencyId
        && request.resource.data.active == resource.data.active
        && request.resource.data.blacklisted == resource.data.blacklisted
        && request.resource.data.blacklistReason == resource.data.blacklistReason
        && request.resource.data.blacklistDate == resource.data.blacklistDate;
    }

    function agencyForDiet(diet) {
      return role() == 'agency_user'
        && diet.data.get('assignedAgencyId', '') in currentUser().get('assignedAgencyIds', []);
    }

    function onlyFinancialFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['fundsReleased', 'expenditure', 'financialProgressPercent', 'updatedAt']);
    }

    function onlyInspectionFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['inspectionRemarks', 'updatedAt']);
    }

    function tenderIdentityUnchanged() {
      return request.resource.data.workPackageId == resource.data.workPackageId
        && request.resource.data.dietId == resource.data.dietId
        && request.resource.data.dietAgencyAssignmentId == resource.data.dietAgencyAssignmentId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function agencyTenderDraftUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status in ['draft', 'revision_required']
        && request.resource.data.status in ['draft', 'revision_required', 'submitted_for_review']
        && request.resource.data.updatedBy == request.auth.uid
        && tenderIdentityUnchanged()
        && request.resource.data.get('approvedForPublicationBy', '') == resource.data.get('approvedForPublicationBy', '')
        && request.resource.data.get('approvedForPublicationAt', '') == resource.data.get('approvedForPublicationAt', '')
        && request.resource.data.get('reviewedBy', '') == resource.data.get('reviewedBy', '')
        && request.resource.data.get('reviewedAt', '') == resource.data.get('reviewedAt', '')
        && request.resource.data.get('scertReviewRemarks', '') == resource.data.get('scertReviewRemarks', '')
        && request.resource.data.get('publishedBy', '') == resource.data.get('publishedBy', '')
        && request.resource.data.get('cancelledBy', '') == resource.data.get('cancelledBy', '');
    }

    function agencyTenderPublicationAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status in ['draft', 'revision_required', 'approved_for_publication']
        && request.resource.data.status == 'published'
        && request.resource.data.publishedBy == request.auth.uid
        && tenderIdentityUnchanged()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'publishedBy', 'publishedAt', 'updatedBy', 'updatedAt']);
    }

    function agencyPublishedPackageUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'approved_for_tender'
        && request.resource.data.status == 'tender_in_progress'
        && request.resource.data.updatedBy == request.auth.uid
        && packageIdentityUnchanged()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'updatedBy', 'updatedAt']);
    }

    function agencyFinancialTenderUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.get('technicalEvaluationStatus', 'not_started') == 'approved'
        && request.resource.data.get('financialEvaluationStatus', 'not_started') in ['in_progress', 'submitted_for_review']
        && resource.data.get('financialEvaluationStatus', 'not_started') in ['not_started', 'in_progress', 'revision_required']
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'financialEvaluationStatus', 'financialBidsOpenedBy', 'financialBidsOpenedAt',
          'financialBidOpeningRecorded', 'financialBidOpeningActualAt', 'financialBidOpeningRecordedBy',
          'financialBidOpeningRecordedAt', 'financialBidOpeningSource', 'financialBidOpeningBidCount',
          'eProcFinancialOpeningReference',
          'financialBidOpeningRemarks', 'financialOpeningOverrideReason', 'financialTieAcknowledged',
          'financialEvaluationRevisionRemarks', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.get('financialEvaluationApprovedBy', '') == resource.data.get('financialEvaluationApprovedBy', '');
    }

    function agencyTechnicalTenderUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'published'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'technicalEvaluationStatus', 'technicalBidsOpenedBy', 'technicalBidsOpenedAt',
          'technicalBidOpeningRecorded', 'technicalBidOpeningActualAt', 'technicalBidOpeningRecordedBy',
          'technicalBidOpeningRecordedAt', 'technicalBidOpeningSource', 'technicalBidOpeningBidCount',
          'technicalBidOpeningReceivedCount', 'eProcTechnicalOpeningReference',
          'technicalBidOpeningRemarks', 'technicalOpeningOverrideReason',
          'technicalEvaluationRemarks', 'noBidsReceived', 'noBidRemarks',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.get('technicalEvaluationStatus', 'not_started') in
          ['not_started', 'in_progress', 'submitted_for_review', 'revision_required'];
    }

    function agencyCorrigendumTenderUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'published'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'bidSubmissionEndDate', 'technicalBidOpeningDate', 'financialBidOpeningDate',
          'updatedBy', 'updatedAt'
        ]);
    }

    function agencyRetenderLinkAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'retender_required'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'replacedByTenderId', 'retenderReason', 'updatedBy', 'updatedAt'
        ]);
    }

    function financialBidIdentityUnchanged() {
      return request.resource.data.tenderId == resource.data.tenderId
        && request.resource.data.tenderBidId == resource.data.tenderBidId
        && request.resource.data.contractorId == resource.data.contractorId
        && request.resource.data.workPackageId == resource.data.workPackageId
        && request.resource.data.dietId == resource.data.dietId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId;
    }

    function awardRecommendationIdentityUnchanged() {
      return request.resource.data.tenderId == resource.data.tenderId
        && request.resource.data.workPackageId == resource.data.workPackageId
        && request.resource.data.dietId == resource.data.dietId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId
        && request.resource.data.contractorId == resource.data.contractorId
        && request.resource.data.recommendedTenderBidId == resource.data.recommendedTenderBidId
        && request.resource.data.recommendedFinancialBidId == resource.data.recommendedFinancialBidId;
    }

    function workOrderIdentityUnchanged() {
      return request.resource.data.tenderAwardId == resource.data.tenderAwardId
        && request.resource.data.tenderId == resource.data.tenderId
        && request.resource.data.workPackageId == resource.data.workPackageId
        && request.resource.data.dietId == resource.data.dietId
        && request.resource.data.executingAgencyId == resource.data.executingAgencyId
        && request.resource.data.contractorId == resource.data.contractorId
        && request.resource.data.contractValue == resource.data.contractValue;
    }

    function agencyAwardWorkOrderStatusUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status in ['approved', 'awarded', 'award_letter_issued', 'work_order_pending']
        && request.resource.data.status in ['work_order_pending', 'work_order_issued']
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedBy', 'updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function agencyPackageWorkOrderLinkAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'awarded'
        && request.resource.data.status == 'awarded'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['workOrderId', 'workOrderNumber', 'workOrderStatus', 'updatedBy', 'updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function agencyAwardTenderUpdateAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.get('financialEvaluationStatus', 'not_started') == 'approved'
        && request.resource.data.get('awardStatus', 'not_started') == 'recommendation_pending'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['awardStatus', 'updatedBy', 'updatedAt'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function agencyAwardTenderFinalizationAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'published'
        && resource.data.get('technicalEvaluationStatus', 'not_started') == 'approved'
        && resource.data.get('financialEvaluationStatus', 'not_started') == 'approved'
        && request.resource.data.get('awardStatus', '') == 'awarded'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'awardStatus', 'selectedContractorId', 'selectedContractorName',
          'tenderAwardId', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function agencyPackageAwardLinkAllowed() {
      return assignedToAgency(resource.data.executingAgencyId)
        && resource.data.status == 'tender_in_progress'
        && request.resource.data.status == 'awarded'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'contractorId', 'contractorName', 'tenderAwardId',
          'finalContractValue', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isScertAdmin());
      allow create: if isScertAdmin() || isOwnPendingUserProfile(userId);
      allow update: if isScertAdmin();
      allow delete: if false;
    }

    match /registrationRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == requestId || isScertAdmin());
      allow create: if isOwnPendingRegistrationRequest(requestId);
      allow update: if isScertAdmin();
      allow delete: if false;
    }

    match /phases/{phaseId} {
      allow read: if isSignedIn() || isScertAdmin();
      allow write: if isScertAdmin();
    }

    match /activityMaster/{activityId} {
       allow read: if isSignedIn() || isScertAdmin();
      allow write: if isScertAdmin();
    }

    match /agencies/{agencyId} {
      allow read: if canViewAllDiets() || assignedToAgency(agencyId);
      allow create, update: if isScertAdmin();
      allow delete: if false;
    }

    match /userAssignments/{assignmentId} {
      allow read: if isScertAdmin()
        || (isActiveApprovedUser() && resource.data.userId == request.auth.uid)
        || (role() == 'diet_nodal_officer' && resource.data.systemRole == 'architecture_user' && resource.data.active == true && resource.data.get('assignedDietIds', []).hasAny(currentUser().get('assignedDietIds', [])));
      allow create, update: if isScertAdmin();
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isScertAdmin();
      allow create: if isScertAdmin()
        || (isActiveApprovedUser()
          && request.resource.data.performedBy == request.auth.uid
          && ((request.resource.data.entityType == 'workPackage'
              && request.resource.data.action in ['work_package_created', 'work_package_updated', 'work_package_financial_breakdown_updated', 'submitted_for_review', 'work_package_submitted', 'work_package_sent_to_diet', 'work_package_diet_review_started', 'work_package_diet_revision_requested', 'work_package_diet_concurred', 'work_package_handshake_completed', 'work_package_submitted_to_scert', 'work_package_scert_review_started', 'work_package_scert_revision_required', 'approved_for_tender']
              && existsAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'contractor'
              && request.resource.data.action in ['contractor_created', 'contractor_updated']
              && existsAfter(/databases/$(database)/documents/contractors/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/contractors/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'scopeOfWork'
&& request.resource.data.action in ['scope_created', 'scope_updated', 'scope_submitted', 'scope_sent_to_agency', 'scope_agency_review_started', 'scope_revision_requested', 'scope_agency_accepted', 'scope_mutually_agreed','scope_sent_to_architecture','architecture_review_started','architecture_scope_revision_requested','diet_drawing_revision_requested','diet_architectural_drawings_accepted','architectural_drawings_submitted_to_scert','scert_drawing_review_started','scert_drawing_revision_required','scert_architectural_drawings_approved','scope_released_to_agency']
              && existsAfter(/databases/$(database)/documents/scopeOfWorks/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/scopeOfWorks/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'tender'
              && request.resource.data.action in ['tender_created', 'tender_updated', 'tender_submitted', 'tender_published', 'no_bids_received', 'record_technical_bid_opening', 'create_retender']
              && existsAfter(/databases/$(database)/documents/tenders/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/tenders/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'workPackage'
              && request.resource.data.action == 'tender_published'
              && existsAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'financial_evaluation'
              && request.resource.data.action in ['financial_bids_opened', 'early_financial_opening_override', 'record_financial_bid_opening', 'financial_bid_amount_entered', 'financial_amount_corrected', 'financial_ranking_recalculated', 'financial_evaluation_submitted'])
            || (request.resource.data.entityType == 'technical_evaluation'
              && request.resource.data.action in ['technical_bids_opened', 'technical_bids_opened_with_override', 'technical_evaluation_submitted', 'record_technical_evaluation', 'verify_technical_evaluation'])
            || (request.resource.data.entityType == 'technical_criterion'
              && request.resource.data.action == 'technical_criterion_created')
            || (request.resource.data.entityType == 'tender_bid'
              && request.resource.data.action in ['participating_bidder_recorded', 'bidder_withdrawn', 'bidder_qualified', 'bidder_disqualified'])
            || (request.resource.data.entityType == 'tender_corrigendum'
              && request.resource.data.action == 'record_corrigendum')
            || (request.resource.data.entityType == 'tender_award_recommendation'
              && request.resource.data.action in ['award_recommendation_created', 'award_recommendation_updated', 'award_recommendation_submitted'])
            || (request.resource.data.entityType == 'tender_award'
              && request.resource.data.action == 'tender_award_created'
              && existsAfter(/databases/$(database)/documents/tenderAwards/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/tenderAwards/$(request.resource.data.entityId)).data.createdBy == request.auth.uid)
            || (request.resource.data.entityType == 'workPackage'
              && request.resource.data.action == 'contractor_linked_to_work_package'
              && existsAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/workPackages/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == 'work_order'
              && request.resource.data.action in ['work_order_created', 'work_order_updated', 'work_order_issued'])
            || (request.resource.data.entityType == 'financial_transaction'
              && request.resource.data.action == 'financial_transaction_created'
              && role() in ['scert_admin','finance_officer']
              && existsAfter(/databases/$(database)/documents/financialTransactions/$(request.resource.data.entityId))
              && getAfter(/databases/$(database)/documents/financialTransactions/$(request.resource.data.entityId)).data.createdBy == request.auth.uid)));
      allow update, delete: if false;
    }

    match /dietAgencyAssignments/{assignmentId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create, update: if isScertAdmin();
      allow delete: if false;
    }

    match /scopeOfWorks/{scopeId} {
      allow read: if canViewAllDiets()||assignedToDiet(resource.data.dietId)||(assignedArchitectureDiet(resource.data.dietId)&&architectureScopeStatus(resource.data.status))||(assignedToAgency(resource.data.executingAgencyId)&&resource.data.status in ['released_to_executing_agency','mutually_agreed','approved']);
      allow create: if assignedToDiet(request.resource.data.dietId)
          && request.resource.data.status == 'draft'
          && request.resource.data.preparedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.scopeCategories.size() > 0
          && request.resource.data.activityIds.size() > 0
          && exists(/databases/$(database)/documents/dietAgencyAssignments/$(request.resource.data.dietAgencyAssignmentId))
          && get(/databases/$(database)/documents/dietAgencyAssignments/$(request.resource.data.dietAgencyAssignmentId)).data.status == 'active';
      allow update: if isScertAdmin() || dietScopeUpdateAllowed() || architectureScopeUpdateAllowed() || agencyScopeReviewAllowed();
      allow delete: if false;
    }

    match /workPackages/{packageId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isActiveApprovedUser()
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.administrativeApprovalAmount == 0
          && request.resource.data.technicalSanctionAmount == 0
          && hasValidActiveAssignment(request.resource.data)
          && validPackageLifecycle(request.resource.data)
          && assignedToAgency(request.resource.data.executingAgencyId);
      allow update: if isScertAdmin()
        || agencyPackageWorkflowAllowed()
        || dietPackageReviewAllowed()
        || agencyPublishedPackageUpdateAllowed()
        || agencyPackageWorkOrderLinkAllowed()
        || agencyPackageAwardLinkAllowed();
      allow delete: if false;
    }

    match /dietActivityFinancials/{financialId} {
      allow read: if canReadActivityFinancial(resource.data);
      allow create, update: if isScertAdmin()
        && historicalFinancialPhase(request.resource.data)
        && request.resource.data.originalApprovedAmount >= 0
        && request.resource.data.currentEffectiveApprovedAmount >= 0
        && request.resource.data.principalAllocation >= 0
        && request.resource.data.agencyAllocation >= 0
        && request.resource.data.totalAllocatedAmount == request.resource.data.principalAllocation + request.resource.data.agencyAllocation
        && request.resource.data.totalAllocatedAmount <= request.resource.data.currentEffectiveApprovedAmount
        && request.resource.data.unallocatedApprovedAmount == request.resource.data.currentEffectiveApprovedAmount - request.resource.data.totalAllocatedAmount
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /financialTransactions/{transactionId} {
      allow read: if canViewAllDiets() || assignedToDiet(resource.data.dietId)
        || (assignedToAgency(resource.data.agencyId) && resource.data.transactionType in ['release_to_agency','diet_to_agency_transfer','agency_expenditure','refund','adjustment']);
      allow create: if role() in ['scert_admin','finance_officer']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount > 0
        && request.resource.data.activityId is string
        && request.resource.data.activityId.size() > 0
        && request.resource.data.documentIds is list;
      allow update, delete: if false;
    }

    match /drawingPackages/{drawingId}{
      allow read: if canViewAllDiets()||assignedToDiet(resource.data.dietId)||isArchitectureUser()||assignedToAgency(resource.data.executingAgencyId);
      allow create: if isArchitectureUser()&&request.resource.data.drawingDiscipline=='architectural'&&request.resource.data.issuedBy==request.auth.uid;
      allow update: if isArchitectureUser()&&request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']);
      allow delete: if false;
    }
    match /communications/{communicationId}{
      allow read: if isScertAdmin()||resource.data.fromUserId==request.auth.uid||resource.data.toUserId==request.auth.uid||role()==resource.data.toRole;
      allow create: if isActiveApprovedUser()&&request.resource.data.fromUserId==request.auth.uid&&request.resource.data.attachmentIds is list;
      allow update,delete: if false;
    }
    match /documentAttachments/{attachmentId}{
      allow read: if isActiveApprovedUser();
      allow create: if isActiveApprovedUser()&&request.resource.data.uploadedBy==request.auth.uid&&request.resource.data.mimeType=='application/pdf'&&request.resource.data.size<=15728640;
      allow update,delete: if false;
    }

    match /tenders/{tenderId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/workPackages/$(request.resource.data.workPackageId))
          && get(/databases/$(database)/documents/workPackages/$(request.resource.data.workPackageId)).data.status == 'approved_for_tender'
          && get(/databases/$(database)/documents/workPackages/$(request.resource.data.workPackageId)).data.dietId == request.resource.data.dietId
          && get(/databases/$(database)/documents/workPackages/$(request.resource.data.workPackageId)).data.executingAgencyId == request.resource.data.executingAgencyId
          && hasValidActiveAssignment(request.resource.data))
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.get('retenderOfTenderId', '') != ''
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.retenderOfTenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.retenderOfTenderId)).data.status == 'retender_required'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.retenderOfTenderId)).data.workPackageId == request.resource.data.workPackageId
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.retenderOfTenderId)).data.executingAgencyId == request.resource.data.executingAgencyId);
      allow update: if isScertAdmin() || agencyTenderDraftUpdateAllowed() || agencyTenderPublicationAllowed() || agencyTechnicalTenderUpdateAllowed() || agencyCorrigendumTenderUpdateAllowed() || agencyRetenderLinkAllowed() || agencyFinancialTenderUpdateAllowed() || agencyAwardTenderUpdateAllowed() || agencyAwardTenderFinalizationAllowed();
      allow delete: if false;
    }

    match /tenderBids/{bidId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.bidSource == 'eproc_punjab'
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.status == 'published'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.executingAgencyId == request.resource.data.executingAgencyId
          && exists(/databases/$(database)/documents/contractors/$(request.resource.data.contractorId))
          && get(/databases/$(database)/documents/contractors/$(request.resource.data.contractorId)).data.active == true
          && get(/databases/$(database)/documents/contractors/$(request.resource.data.contractorId)).data.blacklisted == false);
      allow update: if isScertAdmin()
        || (assignedToAgency(resource.data.executingAgencyId)
          && request.resource.data.tenderId == resource.data.tenderId
          && request.resource.data.contractorId == resource.data.contractorId
          && request.resource.data.executingAgencyId == resource.data.executingAgencyId
          && request.resource.data.recordedBy == resource.data.recordedBy
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /tenderCorrigenda/{corrigendumId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.recordedBy == request.auth.uid
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.status == 'published'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.executingAgencyId == request.resource.data.executingAgencyId);
      allow update, delete: if false;
    }

    match /tenderTechnicalCriteria/{criterionId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.executingAgencyId == request.resource.data.executingAgencyId
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('technicalBidsOpenedAt', null) == null);
      allow update: if isScertAdmin();
      allow delete: if false;
    }

    match /tenderFinancialBids/{financialBidId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.enteredBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.quotedAmount >= 0
          && request.resource.data.finalEvaluatedAmount == request.resource.data.quotedAmount
          && request.resource.data.isSelectedForRecommendation == false
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.executingAgencyId == request.resource.data.executingAgencyId
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('technicalEvaluationStatus', 'not_started') == 'approved'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('financialEvaluationStatus', 'not_started') in ['in_progress', 'revision_required']
          && exists(/databases/$(database)/documents/tenderBids/$(request.resource.data.tenderBidId))
          && get(/databases/$(database)/documents/tenderBids/$(request.resource.data.tenderBidId)).data.qualified == true);
      allow update: if isScertAdmin()
        || (assignedToAgency(resource.data.executingAgencyId)
          && financialBidIdentityUnchanged()
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.quotedAmount >= 0
          && request.resource.data.finalEvaluatedAmount == request.resource.data.quotedAmount
          && request.resource.data.isSelectedForRecommendation == false
          && get(/databases/$(database)/documents/tenders/$(resource.data.tenderId)).data.get('financialEvaluationStatus', 'not_started') in ['in_progress', 'revision_required']);
      allow delete: if false;
    }

    match /tenderAwardRecommendations/{recommendationId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.status == 'draft'
          && request.resource.data.recommendedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.proposedAwardAmount >= 0
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('financialEvaluationStatus', 'not_started') == 'approved'
          && exists(/databases/$(database)/documents/tenderFinancialBids/$(request.resource.data.recommendedFinancialBidId))
          && get(/databases/$(database)/documents/tenderFinancialBids/$(request.resource.data.recommendedFinancialBidId)).data.contractorId == request.resource.data.contractorId);
      allow update: if isScertAdmin()
        || (assignedToAgency(resource.data.executingAgencyId)
          && awardRecommendationIdentityUnchanged()
          && resource.data.status in ['draft', 'revision_required']
          && request.resource.data.status in ['draft', 'revision_required', 'submitted_to_scert']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.get('reviewedBy', '') == resource.data.get('reviewedBy', ''));
      allow delete: if false;
    }

    match /tenderAwards/{awardId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.status == 'awarded'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.awardedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.finalContractValue >= 0
          && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.status == 'published'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('technicalEvaluationStatus', 'not_started') == 'approved'
          && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.get('financialEvaluationStatus', 'not_started') == 'approved'
          && exists(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId))
          && get(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId)).data.executingAgencyId == request.resource.data.executingAgencyId
          && get(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId)).data.contractorId == request.resource.data.contractorId
          && get(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId)).data.status in ['draft', 'revision_required', 'approved']
          && (request.resource.data.isL1 == true
            || get(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId)).data.get('nonL1Justification', '').size() > 0
            || get(/databases/$(database)/documents/tenderAwardRecommendations/$(request.resource.data.recommendationId)).data.get('jointL1Justification', '').size() > 0)
          && (request.resource.data.finalContractValue <= request.resource.data.tenderEstimatedValue
            || request.resource.data.get('remarks', '').size() > 0));
      allow update: if isScertAdmin() || agencyAwardWorkOrderStatusUpdateAllowed();
      allow delete: if false;
    }

    match /workOrders/{workOrderId} {
      allow read: if canReadExecutionRecord(resource.data);
      allow create: if isScertAdmin()
        || (assignedToAgency(request.resource.data.executingAgencyId)
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/tenderAwards/$(request.resource.data.tenderAwardId))
          && get(/databases/$(database)/documents/tenderAwards/$(request.resource.data.tenderAwardId)).data.status in ['approved', 'awarded', 'award_letter_issued', 'work_order_pending']
          && get(/databases/$(database)/documents/tenderAwards/$(request.resource.data.tenderAwardId)).data.finalContractValue == request.resource.data.contractValue);
      allow update: if isScertAdmin()
        || (assignedToAgency(resource.data.executingAgencyId)
          && workOrderIdentityUnchanged()
          && resource.data.status == 'draft'
          && request.resource.data.status in ['draft', 'issued']
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /packageCounters/{dietId} {
      allow read: if isScertAdmin() || assignedToDiet(dietId) || role() == 'agency_user';
      allow create, update: if isScertAdmin() || assignedToDiet(dietId)
        || (role() == 'agency_user' && request.resource.data.nextNumber is int);
      allow delete: if false;
    }

    match /contractors/{contractorId} {
      allow read: if isActiveApprovedUser();
      allow create: if isScertAdmin()
        || (isAssignedAgencyUser()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.blacklisted == false
            && (request.resource.data.sourceAgencyId in currentUser().get('assignedAgencyIds', [])
              || request.resource.data.sourceAgencyId == currentUser().get('primaryAgencyId', null)));
      allow update: if isScertAdmin() || agencyContractorUpdateAllowed();
      allow delete: if false;
    }

    match /systemCounters/contractors {
      allow read, create, update: if isScertAdmin() || isAssignedAgencyUser();
      allow delete: if false;
    }

    match /diets/{dietId} {
      allow read: if isScertAdmin()
        || canViewAllDiets()
        || assignedToDiet(dietId)
        || agencyForDiet(resource);
      allow create, delete: if isScertAdmin();
      allow update: if isScertAdmin()
        || assignedToDiet(dietId)
        || agencyForDiet(resource)
        || (role() == 'finance_officer' && onlyFinancialFieldsChanged())
        || (role() == 'monitoring_officer' && onlyInspectionFieldsChanged());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
